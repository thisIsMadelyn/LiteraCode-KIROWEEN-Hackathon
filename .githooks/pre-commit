#!/usr/bin/env bash
# literacode pre-commit guard.
#
# Install once:  git config core.hooksPath .githooks
#
# Two jobs:
#   1. refuse to commit on main/master
#   2. refuse to commit when src/ no longer matches what lit/ tangles to

set -euo pipefail

branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$branch" == "main" || "$branch" == "master" ]]; then
  echo "pre-commit: refusing to commit directly on '$branch'." >&2
  echo "            work on a feature branch." >&2
  exit 1
fi

# Use the installed `lit`, else any interpreter that can import the package.
if command -v lit >/dev/null 2>&1; then
  LIT=(lit)
elif python3 -c "import literacode" >/dev/null 2>&1; then
  LIT=(python3 -m literacode.cli)
elif python -c "import literacode" >/dev/null 2>&1; then
  LIT=(python -m literacode.cli)
else
  echo "pre-commit: cannot run lit (no 'lit' on PATH, package not importable)." >&2
  exit 1
fi
# src/ is generated from lit/. Block the commit if any generated file differs
# from what tangling lit/*.md would write.
if ! "${LIT[@]}" tangle --check lit/*.md; then
  echo "pre-commit: src/ is out of sync with lit/." >&2
  echo "            edited a document?  run: lit tangle lit/*.md" >&2
  echo "            edited a .py file?  run: lit stitch <file.py>, then lit tangle lit/*.md" >&2
  exit 1
fi

exit 0
